# Local data — must NOT ship in the image. On Render this directory is a
# mount point for the persistent disk; anything baked into the image here
# would be shadowed by the volume anyway, but keeping it out avoids leaking
# whatever PDFs happen to be sitting in the dev machine's storage/ folder.
storage/uploads/
storage/chroma_db/

__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# Never send secrets into the build context.
.env
.env.*
